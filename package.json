{
  "name": "orbit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview --port 3100",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.ts",
    "db:password": "node --env-file-if-exists=.env server/db/password.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@xyflow/vue": "2.0.2",
    "nuxt": "^4.6.4",
    "postgres": "^3.4.9",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "embedded-postgres": "17.12.0-beta.19",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
