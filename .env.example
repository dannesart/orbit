# Copy to .env (never commit .env). Supabase dashboard → Project Settings.

# API Keys: project URL and the *publishable* key.
NUXT_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_SUPABASE_KEY=sb_publishable_...

# Database → Connect → Transaction pooler (port 6543), as the least-privileged orbit_app role.
# Also set this one in Netlify. Password: ALTER ROLE orbit_app WITH PASSWORD '…' (SQL editor).
NUXT_DATABASE_URL=postgresql://orbit_app.<project-ref>:<password>@<pooler-host>:6543/postgres

# Local only, for `npm run db:migrate`: Session pooler (port 5432) as the postgres role.
# Never set this in Netlify.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
